# ══════════════════════════════════════════════════════════════════════
# PMS production environment  →  /var/www/pms/shared/.env   (chmod 600)
# ══════════════════════════════════════════════════════════════════════
# Lives OUTSIDE the release directories, so every release and every
# rollback reads the same configuration. Never commit the real file.
#
# Format rules (python-decouple):
#   - KEY=value, one per line, no spaces around '='
#   - no inline comments after values
#   - no quotes needed (quotes become part of the value)
# ══════════════════════════════════════════════════════════════════════

# ── Core ──────────────────────────────────────────────────────────────
# python3 -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=CHANGE_ME
DEBUG=False
# localhost/127.0.0.1 are required: the deploy script health-checks the
# candidate release on 127.0.0.1 before it receives traffic.
ALLOWED_HOSTS=pms.mcdtronix.co.zw,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://pms.mcdtronix.co.zw
CORS_ALLOWED_ORIGINS=https://pms.mcdtronix.co.zw
TIMEZONE=Africa/Harare

# ── PostgreSQL (required — the deploy aborts on any other engine) ────
DB_ENGINE=django.db.backends.postgresql
DB_NAME=prison_pms
DB_USER=pms_user
DB_PASSWORD=CHANGE_ME
DB_HOST=127.0.0.1
DB_PORT=5432
DB_CONN_MAX_AGE=600

# ── HTTPS (TLS terminates at nginx, which also redirects HTTP) ───────
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=31536000
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True

# ── Sign-in throttling (Auth/lockout.py) ─────────────────────────────
# Real client address: nginx sets X-Real-IP on every request. Required for
# the per-address limit and for accurate IPs in the sign-in and audit logs.
CLIENT_IP_HEADER=HTTP_X_REAL_IP
# Failures per account name before sign-in under that name is paused.
LOGIN_ACCOUNT_MAX_FAILURES=5
LOGIN_ACCOUNT_WINDOW_MINUTES=15
# Failures per IP address (any names) before that address is paused.
LOGIN_ADDRESS_MAX_FAILURES=20
LOGIN_ADDRESS_WINDOW_MINUTES=15

# ── Back-office pages ────────────────────────────────────────────────
# The raw Django admin and the API docs are developer tools; the app has its
# own administration console. Both are OFF unless switched on here.
ADMIN_ENABLED=False
# When enabled, limit the Django admin to these IPs/networks (comma-separated).
ADMIN_ALLOWED_IPS=
# API docs (Swagger/ReDoc), staff-only when enabled.
API_DOCS_ENABLED=False

# ── One-time passwords (Auth/one_time.py) ────────────────────────────
# Minutes an administrator-issued one-time password stays valid.
TEMP_PASSWORD_TTL_MINUTES=30

# ── Uploads (Core/uploads.py) ────────────────────────────────────────
# Per-file limits for court warrants, receipts, certificates and documents,
# and for inmate photos. Larger uploads stream to disk, not memory.
UPLOAD_MAX_DOCUMENT_BYTES=10485760
UPLOAD_MAX_PHOTO_BYTES=5242880
FILE_UPLOAD_MAX_MEMORY_SIZE=2621440

# ── Observability ────────────────────────────────────────────────────
SENTRY_DSN=

# ── Messaging ────────────────────────────────────────────────────────
# Downloads are approved by Django and streamed by nginx (X-Accel-Redirect).
MESSAGING_X_ACCEL_REDIRECT=True
MESSAGING_MAX_ATTACHMENT_BYTES=10485760
MESSAGING_MAX_ATTACHMENTS=5
# Optional grammar checker on this machine; see deploy/LANGUAGETOOL.md.
# Leave empty to hide the "Check spelling and grammar" button.
LANGUAGETOOL_URL=
LANGUAGETOOL_LANGUAGE=en-GB

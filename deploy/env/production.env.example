# ══════════════════════════════════════════════════════════════════════
# PMS production environment  →  /var/www/pms/shared/.env   (chmod 600)
# ══════════════════════════════════════════════════════════════════════
# Lives OUTSIDE the release directories, so every release and every
# rollback reads the same configuration. Never commit the real file.
#
# Format rules (python-decouple):
#   - KEY=value, one per line, no spaces around '='
#   - no inline comments after values
#   - no quotes needed (quotes become part of the value)
# ══════════════════════════════════════════════════════════════════════

# ── Core ──────────────────────────────────────────────────────────────
# python3 -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=CHANGE_ME
DEBUG=False
# localhost/127.0.0.1 are required: the deploy script health-checks the
# candidate release on 127.0.0.1 before it receives traffic.
ALLOWED_HOSTS=pms.mcdtronix.co.zw,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://pms.mcdtronix.co.zw
CORS_ALLOWED_ORIGINS=https://pms.mcdtronix.co.zw
TIMEZONE=Africa/Harare

# ── PostgreSQL (required — the deploy aborts on any other engine) ────
DB_ENGINE=django.db.backends.postgresql
DB_NAME=prison_pms
DB_USER=pms_user
DB_PASSWORD=CHANGE_ME
DB_HOST=127.0.0.1
DB_PORT=5432
DB_CONN_MAX_AGE=600

# ── HTTPS (TLS terminates at nginx, which also redirects HTTP) ───────
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=31536000
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True

# ── Observability ────────────────────────────────────────────────────
SENTRY_DSN=

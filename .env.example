# =====================================================
# PRISON MANAGEMENT SYSTEM - ENVIRONMENT CONFIGURATION
# =====================================================
# Copy this file to .env and populate with real values
# NEVER commit .env to version control
# =====================================================

# ==================================================
# CORE SECURITY
# ==================================================
# Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-secret-key-here-change-in-production

# Debug mode (NEVER True in production)
DEBUG=False

# Allowed hosts (comma-separated, no spaces after commas)
ALLOWED_HOSTS=localhost,127.0.0.1,your-domain.com

# ==================================================
# DATABASE CONFIGURATION (PostgreSQL)
# ==================================================
# PostgreSQL connection details (required for Phase 0+)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=prison_pms
DB_USER=pms_user
DB_PASSWORD=your-secure-db-password
DB_HOST=localhost
DB_PORT=5432

# Connection pooling
DB_CONN_MAX_AGE=600

# ==================================================
# CORS CONFIGURATION
# ==================================================
# Frontend origin(s) for CORS (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://your-frontend-domain.com

# ==================================================
# JWT TOKEN CONFIGURATION
# ==================================================
# Access token lifetime (in hours)
JWT_ACCESS_TOKEN_LIFETIME=8

# Refresh token lifetime (in days)
JWT_REFRESH_TOKEN_LIFETIME=7

# ==================================================
# EMAIL CONFIGURATION (for future notifications/messaging)
# ==================================================
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# For production SMTP:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-specific-password
DEFAULT_FROM_EMAIL=noreply@prison-pms.com

# ==================================================
# ORGANIZATION HIERARCHY INITIALIZATION
# ==================================================
# National HQ configuration (Phase 1 setup)
INITIAL_ORG_TYPE=NATIONAL_HQ
INITIAL_ORG_NAME=National Headquarters
INITIAL_ORG_CODE=NAT_HQ_001

# ==================================================
# LOGGING CONFIGURATION
# ==================================================
# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Audit log file location
AUDIT_LOG_FILE=logs/audit.log

# ==================================================
# SESSION & SECURITY COOKIES
# ==================================================
# Secure cookies (HTTPS only in production)
SESSION_COOKIE_SECURE=True
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Strict
CSRF_COOKIE_SECURE=True
CSRF_COOKIE_HTTPONLY=True

# Session timeout (in seconds)
SESSION_COOKIE_AGE=28800  # 8 hours

# ==================================================
# FILE UPLOAD CONFIGURATION
# ==================================================
# Max upload size (in bytes, default 100MB)
FILE_UPLOAD_MAX_MEMORY_SIZE=104857600

# Allowed upload extensions
ALLOWED_UPLOAD_EXTENSIONS=pdf,jpg,jpeg,png,doc,docx,xls,xlsx

# ==================================================
# TIMEZONE
# ==================================================
TIMEZONE=Africa/Harare

# ==================================================
# MESSAGING/INBOX CONFIGURATION (Phase 3)
# ==================================================
# Message retention period (in days)
MESSAGE_RETENTION_DAYS=365

# Max message recipients per thread
MAX_THREAD_RECIPIENTS=50

# ==================================================
# BACKUP & COMPLIANCE
# ==================================================
# Database backup path
BACKUP_PATH=/var/backups/prison_pms

# Audit trail retention (in days)
AUDIT_RETENTION_DAYS=2555  # ~7 years

# ==================================================
# DEVELOPMENT / STAGING FLAGS
# ==================================================
# Enable Django debug toolbar (dev only)
ENABLE_DEBUG_TOOLBAR=False

# Mock email (dev only - sends to console)
USE_MOCK_EMAIL=True

# =====================================================
# NOTES FOR DEPLOYMENT
# =====================================================
# Phase 0: Update DB_* variables and SECRET_KEY
# Phase 1: Add ORG_UNIT_* variables after hierarchy models created
# Phase 2: Configure EMAIL_* for notification system
# Phase 3: Configure MESSAGE_* variables for inbox system
# Always use strong passwords in production (min 32 chars, mixed case, numbers, symbols)
# Rotate SECRET_KEY and database passwords regularly
# =====================================================

# Files executed or parsed on Linux must keep LF line endings, even when
# committed from Windows (CRLF breaks shebangs: "bad interpreter: ^M").
*.sh        text eol=lf
*.service   text eol=lf
*.conf      text eol=lf
*.py        text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
deploy/sudoers/*   text eol=lf
deploy/env/*       text eol=lf
